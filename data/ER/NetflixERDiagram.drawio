        <mxCell id="RF42ELWN8jyHylpuTjHy-140" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=18;" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Each show exists only once in &lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;NetflixDataset &lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;but can be referenced multiple times in the junction tables.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="555" x="915" y="360" as="geometry" />
        </mxCell>
        <mxCell id="RF42ELWN8jyHylpuTjHy-141" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=17;" value="&lt;blockquote&gt;&lt;p&gt;The &lt;b&gt;NetflixDataset&lt;/b&gt; table serves as the central entity, with each title uniquely identified by its ShowID. Many-to-many relationships between titles and countries, cast members, directors, and categories are resolved through junction tables. These tables reference their respective entities using foreign keys, reducing data redundancy and maintaining referential integrity.&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
